# ============================================
# 多币种资金费率套利机器人 v2.0 配置
# ============================================

# 币安API密钥
# 注意：只开通 现货和合约 交易权限，不要开通提币权限！
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# ========== 功能1: 多币种轮动 ==========
# 监控的交易对列表，逗号分隔
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT

# 同时持仓的最大币种数量
MAX_POSITIONS=3

# 开仓资金费率阈值 (默认 0.05%)
FUNDING_RATE_THRESHOLD=0.0005

# 平仓资金费率阈值 (默认 0.02%)
FUNDING_RATE_CLOSE_THRESHOLD=0.0002

# ========== 功能2: 杠杆优化 ==========
# 杠杆倍数 (推荐 2-3倍，不要太高！)
LEVERAGE=3

# 单币种仓位价值 (USDT，例如1000 USDT等值的币)
POSITION_VALUE_USDT=1000

# ========== 功能3: 自动移仓 ==========
# 移仓阈值：新币种费率比当前持仓高多少时移仓 (0.03% = 0.0003)
SWITCH_THRESHOLD=0.0003

# ========== 功能4: 网格增强 ==========
# 是否启用网格交易 (true/false)
GRID_ENABLED=true

# 网格层数
GRID_LEVELS=5

# 网格间距百分比 (0.3% = 0.003)
GRID_SPACING=0.003

# 每网格订单占主仓位的比例 (10% = 0.1)
GRID_ORDER_RATIO=0.1

# ========== 风控配置 ==========
# 单日最大亏损 (USDT)，超过则停止交易
MAX_DAILY_LOSS=100

# 最小账户余额要求 (USDT)
MIN_BALANCE=500

# 止损百分比 (2% = 0.02)
STOP_LOSS_PERCENT=0.02

# 最大回撤百分比 (10% = 0.1)
MAX_DRAWDOWN_PERCENT=0.1

# ========== 运行配置 ==========
# 策略检查间隔 (毫秒，默认10分钟)
CHECK_INTERVAL_MS=600000

# 资金费率更新间隔 (毫秒，默认30分钟)
RATE_UPDATE_INTERVAL_MS=1800000

# 模拟模式 (true/false，默认true，设置为false会真实下单!)
SIMULATION_MODE=true
