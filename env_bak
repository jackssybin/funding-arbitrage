# ============================================
# 多币种资金费率套利机器人 v3.0 配置
# ============================================

# ========== 交易所选择 ==========
# 使用哪家交易所：binance 或 okx
EXCHANGE=okx

# ========== Binance API 密钥（EXCHANGE=binance 时填写）==========
# 只开通 现货+合约 权限，绝对不要开提币权限！
API_KEY=your_binance_api_key_here
SECRET_KEY=your_binance_secret_key_here

# ========== OKX API 密钥（EXCHANGE=okx 时填写）==========
# 只开通 读取+交易 权限，绝对不要开提币权限！
OKX_API_KEY=85c571c6-dbab-40ad-b685-b7fb53e9abd7
OKX_SECRET_KEY=57BB79C6E8F7573922B60F9D100F4E48
# OKX 独有的 Passphrase：就是你创建 API 时自己设置的那个短语
OKX_PASSPHRASE=openclaw-use
# OKX 官方模拟盘开关（true=模拟盘环境测试，false=真实实盘）
OKX_SIMULATED_TRADING=false

# ========== 功能1: 多币种轮动 ==========
# 监控的交易对列表，逗号分隔
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT

# 同时持仓的最大币种数量（优化：增加到2个，分散风险）
MAX_POSITIONS=2

# 开仓资金费率阈值 (对冲模式建议：0.40%以上，覆盖手续费+滑点成本)
FUNDING_RATE_THRESHOLD=0.0040

# 平仓资金费率阈值 (优化：提高到0.05%)
FUNDING_RATE_CLOSE_THRESHOLD=0.0005

# ========== 功能2: 杠杆优化 ==========
# 杠杆倍数 (优化：降低到1.5倍，防止爆仓)
LEVERAGE=2

# 单币种仓位价值 (USDT，降低到750，分散到2个币种)
POSITION_VALUE_USDT=750

# ========== 功能3: 自动移仓 ==========
# 移仓阈值：新币种费率比当前持仓高多少时移仓 (0.03% = 0.0003)
SWITCH_THRESHOLD=0.0003

# ========== 功能4: 网格增强 ==========
# 是否启用网格交易 (true/false)
GRID_ENABLED=true

# 网格层数
GRID_LEVELS=5

# 网格间距百分比 (0.3% = 0.003)
GRID_SPACING=0.003

# 每网格订单占主仓位的比例 (10% = 0.1)
GRID_ORDER_RATIO=0.1

# ========== 风控配置 ==========
# 单日最大亏损 (USDT)，超过则停止交易
MAX_DAILY_LOSS=2000

# 最小账户余额要求 (USDT)
MIN_BALANCE=500

# 同币种止损后冷却期（毫秒，默认2小时=7200000）
STOP_LOSS_COOLDOWN_MS=7200000

# 费率稳定检查次数（默认3次，即30分钟稳定才开仓）
RATE_STABLE_CHECK_COUNT=3

# 止损百分比 (对冲模式：建议15%，因为价格波动已被对冲)
STOP_LOSS_PERCENT=0.15

# 止盈百分比 (对冲模式：基于资金费进度，不是价格)
TAKE_PROFIT_RATIO=0.15

# ========== 现货对冲配置 ==========
# 是否启用现货对冲（true=中性套利，false=纯合约风险套利）
SPOT_HEDGE_ENABLED=false

# 现货对冲比例（1.0=1:1完全对冲，降低风险但也降低收益）
SPOT_HEDGE_RATIO=1.0

# 现货手续费率（默认0.1%=千一，OKX普通用户taker费率）
SPOT_TAKER_FEE_RATE=0.0010

# 现货滑点率（默认0.05%，高波动币种可能更高）
SPOT_SLIPPAGE_RATE=0.0005

# 最低持仓小时数（至少持有N小时保证获得至少1次资金费）
MIN_HOLDING_HOURS=8

# ========== 连续亏损保护 ==========
# 连续N次亏损后暂停开仓
PAUSE_AFTER_CONSECUTIVE_LOSSES=2

# 连续亏损后暂停时长（毫秒，默认4小时）
CONSECUTIVE_LOSS_PAUSE_MS=14400000

# 最大回撤百分比 (10% = 0.1)
MAX_DRAWDOWN_PERCENT=0.1

# 预期资金费结算次数（方案C: 调为2次，提高预期收益覆盖成本）
LIVE_EXPECTED_FUNDING_SETTLEMENTS=2

# 预期净收益最低门槛（方案C: 降为0，允许微利开仓）
LIVE_MIN_EXPECTED_NET_FUNDING_AFTER_COSTS=0

# 排除币种列表（默认排除了SOL/XRP/DOGE，方案C: 清空排除列表，允许所有币种交易）
EXCLUDED_SYMBOLS=

# 方案C: 正费率开仓阈值从0.10%降至0.05%，允许更多币种通过第一道过滤
MIN_FUNDING_RATE_POSITIVE=0.0005

# 方案C: 负费率开仓阈值从0.15%降至0.08%
MIN_FUNDING_RATE_NEGATIVE=0.0008

# ========== 运行配置 ==========
# 策略检查间隔 (毫秒，默认10分钟)
CHECK_INTERVAL_MS=600000

# 资金费率更新间隔 (毫秒，默认30分钟)
RATE_UPDATE_INTERVAL_MS=1800000

# 模拟模式 (true/false，默认true，设置为false会真实下单!)
SIMULATION_MODE=true


# 飞书推送配置
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/fbdf62a7-acfc-41a1-9d01-91aa1d37d1c6
# 推送频率：daily=每天日报，hourly=每小时推送，realtime=实时推送
NOTIFY_FREQUENCY=daily
